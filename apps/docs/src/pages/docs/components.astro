---
import Base from "@/src/layouts/Base.astro"
import ComponentsGalleryPage, {
  type ComponentsGalleryData,
  type GalleryGroup,
} from "@/components/pages/components-gallery-page"
import { siteNavGroups } from "@/lib/build"
import { getGroups, getItems } from "@/lib/docs"

/** Documented and installable, but not shown as gallery cards. */
const notInGallery = new Set(["theme-paper"])

const groups: GalleryGroup[] = getGroups()
  .map((g) => ({
    category: g.category,
    items: g.items.filter((i) => !notInGallery.has(i.name)).map(({ name, title }) => ({ name, title })),
  }))
  .filter((g) => g.items.length > 0)

const data: ComponentsGalleryData = { groups, total: getItems().length }
const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Components">
  <ComponentsGalleryPage client:load site={site} data={data} />
</Base>
