---
import Base from "@/src/layouts/Base.astro"
import ThemingPage, { type ThemingData } from "@/components/pages/theming-page"
import { docNav, highlightAll, siteNavGroups } from "@/lib/build"

const CSS_EXAMPLE = `:root {
  --radius: 0.5rem;
  --radius-max: 1rem;             /* no token goes past 16px */
  --background: #fff;
  --foreground: #000000df;        /* 16:1 */
  --muted-foreground: #0000009b;  /* 5.9:1 */
  --fill-hover: #0000000f;        /* secondary and muted read it */
  --primary: oklch(56% 0.1671 251.78);       /* white label 4.6:1 */
  --primary-text: oklch(53% 0.1504 251.78);  /* links, 5.1:1 */
  --ring: oklch(56% 0.1671 251.78);
  --border: #00000017;
  --border-control: #0000006e;    /* 3.1:1 */
  --shadow-lg: 0 0 0 0.5px #0000000f, 0 2px 3px -2px #0000000f, …;
  /* … */
}

.dark {
  --background: oklch(15% 0 0);
  --card: #111;
  --popover: oklch(25.2% 0 0);
  --foreground: #ffffffed;
  --primary-text: oklch(72% 0.1501 251.78);
  --border: #ffffff1b;
  /* … */
}

@theme inline {
  --color-background: var(--background);
  --color-primary: var(--primary);
  --color-primary-text: var(--primary-text);
  --radius-xl: min(calc(var(--radius) * 1.25), var(--radius-max));
  --shadow-lg: var(--shadow-lg);
  /* … */
}`

const DARK_SCRIPT = `// Inline in <head>, before paint, so the page never flashes the wrong theme.
const mode = localStorage.getItem("theme") ?? "system"
const dark = mode === "dark" || (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches)
document.documentElement.classList.toggle("dark", dark)
document.documentElement.style.colorScheme = dark ? "dark" : "light"`

const ACCENT_RUNTIME = `/* Switch at runtime by setting data-accent on <html>: one block per mode swaps the ten roles */
html[data-accent="violet"] {
  --primary: oklch(54.17% 0.179 288.03);
  --primary-hover: oklch(50.67% 0.179 288.03);
  --primary-active: oklch(47.17% 0.179 288.03);
  --primary-foreground: oklch(100% 0 0);
  --primary-subtle: oklch(54.17% 0.179 288.03 / 0.1);
  --primary-subtle-hover: oklch(54.17% 0.179 288.03 / 0.16);
  --primary-border: oklch(54.17% 0.179 288.03 / 0.32);
  --primary-text: oklch(54% 0.1611 288.03);
  --ring: oklch(54.17% 0.179 288.03);
  --selection: oklch(54.17% 0.179 288.03 / 0.22);
}
html[data-accent="violet"].dark {
  --primary-text: oklch(72% 0.1548 288.03);
  --selection: oklch(54.17% 0.179 288.03 / 0.4);
  /* … */
}`

const NEW_TOKEN = `:root  { --brand-2: oklch(0.6 0.12 200); }
.dark  { --brand-2: oklch(0.68 0.12 200); }

@theme inline {
  --color-brand-2: var(--brand-2);   /* → bg-brand-2, text-brand-2, ring-brand-2/20 … */
}`

const code = await highlightAll(
  { css: CSS_EXAMPLE, darkScript: DARK_SCRIPT, accentRuntime: ACCENT_RUNTIME, newToken: NEW_TOKEN },
  { css: "css", darkScript: "js", accentRuntime: "css", newToken: "css" },
)

const data: ThemingData = {
  nav: docNav("/docs/theming", ["components/pages/theming-page.tsx", "components/docs/theming-system.tsx"]),
  code,
}
const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Theming">
  <ThemingPage client:load site={site} data={data} />
</Base>
