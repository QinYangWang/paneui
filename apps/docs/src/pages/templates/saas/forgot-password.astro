---
import Base from "@/src/layouts/Base.astro"
import { SaasForgotPasswordRoute } from "@/components/pages/templates/saas-auth-route"
import { siteNavGroups } from "@/lib/build"

const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Reset password">
  <SaasForgotPasswordRoute client:load site={site} />
</Base>
