import { SaasNotFoundRoute } from "@/components/pages/templates/saas-marketing-route"
import { siteNavGroups } from "@/lib/build"

const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Page not found">
  <SaasNotFoundRoute client:load site={site} />
</Base>
