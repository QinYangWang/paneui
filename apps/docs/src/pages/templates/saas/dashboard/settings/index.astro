---
import Base from "@/src/layouts/Base.astro"
import { SaasSettingsProfileRoute } from "@/components/pages/templates/saas-settings-route"
import { siteNavGroups } from "@/lib/build"

const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Profile settings">
  <SaasSettingsProfileRoute client:load site={site} />
</Base>
