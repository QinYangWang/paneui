---
import Base from "@/src/layouts/Base.astro"
import { SaasVerifyRoute } from "@/components/pages/templates/saas-auth-route"
import { siteNavGroups } from "@/lib/build"

const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Verify your email">
  <SaasVerifyRoute client:load site={site} />
</Base>
