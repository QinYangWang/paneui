---
import Base from "@/src/layouts/Base.astro"
import { SaasSignupRoute } from "@/components/pages/templates/saas-auth-route"
import { siteNavGroups } from "@/lib/build"

const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Create account">
  <SaasSignupRoute client:load site={site} />
</Base>
