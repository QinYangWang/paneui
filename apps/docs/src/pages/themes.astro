---
import fs from "node:fs"

import Base from "@/src/layouts/Base.astro"
import ThemesPage, { type ThemesData } from "@/components/pages/themes-page"
import { siteNavGroups } from "@/lib/build"
import { repoPath } from "@/lib/repo-path"
import { parseThemeTokens } from "@/components/docs/theming-tokens"

/** Light/dark values straight from the theme, read once at build time. */
const data: ThemesData = { theme: parseThemeTokens(fs.readFileSync(repoPath("packages/tokens/styles/globals.css"), "utf8")) }
const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Customize">
  <ThemesPage client:load site={site} data={data} />
</Base>
