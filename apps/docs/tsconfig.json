{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@paneui/ui/*": [
        "../../packages/ui/src/*"
      ],
      "next/link": [
        "./shims/next-link.tsx"
      ],
      "next/navigation": [
        "./shims/next-navigation.tsx"
      ],
      "next/dynamic": [
        "./shims/next-dynamic.tsx"
      ]
    },
    "types": [
      "astro/client"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".astro"
  ]
}
