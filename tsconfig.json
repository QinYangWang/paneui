{
  "extends": "./apps/docs/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./apps/docs/*"
      ]
    }
  },
  "include": [
    "apps/docs/**/*.ts",
    "apps/docs/**/*.tsx",
    "apps/docs/.next/types/**/*.ts",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "packages/core/src/**/*.ts",
    "packages/tokens/src/**/*.ts",
    "tooling/scripts/**/*.tsx",
    "tooling/scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/docs/node_modules",
    "apps/docs/.next/cache",
    "apps/docs/out",
    "tooling/scripts/fixtures"
  ]
}
