{
  "name": "@taimatsu/paneui",
  "version": "0.1.0",
  "description": "Find, install and update paneui components.",
  "keywords": [
    "shadcn",
    "registry",
    "cli",
    "components",
    "react",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "Wang Qinyang",
  "homepage": "https://paneui.dev/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taimatsuorg/paneui.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/taimatsuorg/paneui/issues",
  "type": "module",
  "bin": {
    "paneui": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
