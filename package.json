{
  "name": "paneui-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @paneui/docs dev",
    "build": "pnpm --filter @paneui/docs build",
    "build:cloudflare": "pnpm registry:build && pnpm build && pnpm docs:md:audit && node tooling/scripts/build-pages.mjs",
    "start": "pnpm --filter @paneui/docs exec next start",
    "lint": "eslint .",
    "registry:build": "pnpm tokens:gen && node tooling/scripts/gen-icon-styles.mjs && node tooling/scripts/gen-og-tokens.mjs && shadcn build packages/registry/registry.json --output apps/docs/public/r && node tooling/scripts/registry-postbuild.mjs",
    "icons:gen": "node tooling/scripts/gen-icon-styles.mjs",
    "og:tokens": "node tooling/scripts/gen-og-tokens.mjs",
    "docs:gen": "node tooling/scripts/gen-docs.mjs",
    "docs:md": "node --experimental-strip-types --no-warnings tooling/scripts/gen-docs-md.mjs",
    "docs:md:audit": "node tooling/scripts/audit-docs-md.mjs",
    "templates:code": "node --experimental-strip-types tooling/scripts/gen-template-code.mjs",
    "audit:radius": "node tooling/scripts/audit-radius.mjs",
    "design:check": "node skills/paneui-design/scripts/check.mjs apps/docs packages/ui/src packages/core/src packages/tokens/src packages/ui-native/src apps/native skills packages/registry/registry.json",
    "test:cover-art": "node tooling/scripts/test-cover-art-seeds.mjs",
    "test:labels": "node tooling/scripts/run-tsx.mjs tooling/scripts/test-default-labels.tsx",
    "cli:build": "pnpm --filter paneui build",
    "cli:test": "pnpm --filter paneui test",
    "typecheck": "pnpm -r --if-present typecheck",
    "registry:test": "pnpm --filter @paneui/registry test",
    "tokens:gen": "node tooling/scripts/gen-native-tokens.mjs",
    "native": "pnpm --filter @paneui/native-showcase start",
    "native:web": "pnpm --filter @paneui/native-showcase web",
    "native:build": "pnpm tokens:gen && pnpm --filter @paneui/native-showcase build:web",
    "test:pages": "node --test tooling/scripts/pages-output.test.mjs",
    "design:test": "node skills/paneui-design/scripts/check.mjs --self-test && node --test skills/paneui-design/scripts/native-checks.test.mjs",
    "test:highlight": "node --experimental-strip-types --test tooling/scripts/highlight.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.1",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.3.1",
    "jiti": "2.5.1",
    "mdast-util-mdx": "^3.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "@paneui/ui": "workspace:*",
    "@paneui/core": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "shadcn": "^4.21.4"
  }
}
