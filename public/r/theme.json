  "css": {
    "@layer base": {
      "::-webkit-scrollbar": {
        "width": "12px",
        "height": "12px"
      },
      "::-webkit-scrollbar-track, ::-webkit-scrollbar-corner": {
        "background": "transparent"
      },
      "::-webkit-scrollbar-thumb": {
        "border": "3px solid transparent",
        "border-radius": "9999px",
        "background-color": "var(--scrollbar)",
        "background-clip": "padding-box",
        "min-height": "40px"
      },
      "::-webkit-scrollbar-thumb:hover": {
        "background-color": "var(--scrollbar-hover)"
      },
      "@supports not selector(::-webkit-scrollbar)": {
        "*": {
          "scrollbar-width": "thin",
          "scrollbar-color": "var(--scrollbar) transparent"
        }
      },
      "body": {
        "letter-spacing": "normal"
      },
      "code, kbd, pre, samp": {
        "font-feature-settings": "normal"
      }
    },
    "@utility scrollbar-thin": {
      "scrollbar-width": "thin",
      "&::-webkit-scrollbar": {
        "width": "10px",
        "height": "10px"
      }
    },
    "@utility scrollbar-hover": {
      "scrollbar-color": "transparent transparent",
      "&::-webkit-scrollbar-thumb": {
        "background-color": "transparent"
      },
      "&:hover": {
        "scrollbar-color": "var(--scrollbar) transparent"
      },
      "&:hover::-webkit-scrollbar-thumb": {
        "background-color": "var(--scrollbar)"
      }
    },
    "@utility scrollbar-none": {
      "scrollbar-width": "none",
      "&::-webkit-scrollbar": {
        "display": "none"
      }
    },
    "@utility shell-inset": {
      "background-color": "var(--background)",
      "border": "0.5px solid var(--shell-border)",
      "border-radius": "calc(var(--radius) * 1.3)",
      "margin-inline-end": "3px",
      "margin-bottom": "3px"
    },
    "@utility window-drag": {
      "-webkit-app-region": "drag",
      "user-select": "none"
    },
    "@utility window-no-drag": {
      "-webkit-app-region": "no-drag"
    },
    "@supports (color: color(display-p3 1 1 1))": {
      "@media (color-gamut: p3)": {
        "html[data-accent=\"green\"]": {
          "primary": "color(display-p3 .332 .634 .442)",
          "primary-hover": "color(display-p3 .308 .595 .417)",
          "primary-active": "color(display-p3 .19 .5 .32)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .012 .596 .145/.087)",
          "primary-subtle-hover": "color(display-p3 .008 .588 .145/.142)",
          "primary-border": "color(display-p3 .004 .518 .157/.283)",
          "ring": "color(display-p3 0 .478 .2/.55)"
        },
        "html[data-accent=\"green\"].dark": {
          "primary": "color(display-p3 .332 .634 .442)",
          "primary-hover": "color(display-p3 .357 .682 .474)",
          "primary-active": "color(display-p3 .434 .828 .573)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .376 .996 .655/.114)",
          "primary-subtle-hover": "color(display-p3 .341 .996 .635/.173)",
          "primary-border": "color(display-p3 .475 1 .706/.29)",
          "ring": "color(display-p3 .502 .996 .682/.61)"
        },
        "html[data-accent=\"orange\"]": {
          "primary": "color(display-p3 .9 .45 .2)",
          "primary-hover": "color(display-p3 .87 .409 .164)",
          "primary-active": "color(display-p3 .76 .34 0)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .922 .584 .008/.15)",
          "primary-subtle-hover": "color(display-p3 1 .604 .004/.314)",
          "primary-border": "color(display-p3 .949 .494 .004/.455)",
          "ring": "color(display-p3 .804 .349 0/.62)"
        },
        "html[data-accent=\"orange\"].dark": {
          "primary": "color(display-p3 .9 .45 .2)",
          "primary-hover": "color(display-p3 .98 .51 .23)",
          "primary-active": "color(display-p3 1 .63 .38)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .996 .486 0/.131)",
          "primary-subtle-hover": "color(display-p3 .996 .384 0/.211)",
          "primary-border": "color(display-p3 1 .529 .129/.332)",
          "ring": "color(display-p3 1 .494 .216/.895)"
        },
        "html[data-accent=\"rose\"]": {
          "primary": "color(display-p3 .843 .298 .507)",
          "primary-hover": "color(display-p3 .807 .266 .468)",
          "primary-active": "color(display-p3 .731 .195 .388)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .859 .008 .294/.083)",
          "primary-subtle-hover": "color(display-p3 .827 .008 .298/.134)",
          "primary-border": "color(display-p3 .682 .004 .247/.244)",
          "ring": "color(display-p3 .6 .004 .251/.408)"
        },
        "html[data-accent=\"rose\"].dark": {
          "primary": "color(display-p3 .843 .298 .507)",
          "primary-hover": "color(display-p3 .864 .364 .539)",
          "primary-active": "color(display-p3 1 .56 .66)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .996 .227 .573/.148)",
          "primary-subtle-hover": "color(display-p3 1 .157 .569/.227)",
          "primary-border": "color(display-p3 1 .337 .643/.349)",
          "ring": "color(display-p3 1 .345 .596/.832)"
        },
        "html[data-accent=\"violet\"]": {
          "primary": "color(display-p3 .417 .341 .784)",
          "primary-hover": "color(display-p3 .381 .306 .741)",
          "primary-active": "color(display-p3 .383 .317 .702)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .204 .004 .871/.059)",
          "primary-subtle-hover": "color(display-p3 .196 .004 1/.102)",
          "primary-border": "color(display-p3 .153 .004 .906/.208)",
          "ring": "color(display-p3 .133 .004 .753/.397)"
        },
        "html[data-accent=\"violet\"].dark": {
          "primary": "color(display-p3 .417 .341 .784)",
          "primary-hover": "color(display-p3 .477 .402 .823)",
          "primary-active": "color(display-p3 .72 .65 1)",
          "primary-foreground": "#fff",
          "primary-subtle": "color(display-p3 .494 .337 .996/.202)",
