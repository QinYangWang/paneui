{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Theme",
  "description": "Native desktop tokens after Synara/Codex: system UI font (-apple-system/Segoe UI) on a 13px type scale (text-ui-2xs/xs/sm/ui/lg = 10/11/12/13/14px), translucent black/white fills for secondary/muted/accent, 5-6% hairline borders, a neutral black/white primary (accent presets: theme-blue, theme-green, theme-orange, theme-rose, theme-violet), a five-hue chart palette (chart-1..5), a 0.625rem radius with multiplier steps (sm .6x, md .8x, xl 1.4x, 2xl 1.8x, shell 1.3x), near-flat elevation shadows (raised, pressed, primary, well, surface, chip), shell/shell-border app-chrome tokens and a shell-inset utility for the rail layout, code surface and scrollbar tokens with thin rounded scrollbars and scrollbar-thin/-hover/-none utilities, reading tokens (max-w-reading 68ch, max-w-page, image outline) and a prose-qy long-form typography utility. Installs @qinyang/utils (cn that knows the text-ui sizes).",
  "registryDependencies": [
    "@qinyang/utils"
  ],
  "cssVars": {
    "theme": {
      "color-code": "var(--code)",
      "font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
      "font-mono": "var(--font-jetbrains-mono, \"JetBrains Mono\"), \"JetBrains Mono\", \"SF Mono\", \"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace",
      "color-success": "var(--success)",
      "color-warning": "var(--warning)",
      "color-chart-1": "var(--chart-1)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-5": "var(--chart-5)",
      "color-shell": "var(--shell)",
      "color-shell-border": "var(--shell-border)",
      "radius-sm": "calc(var(--radius) * 0.6)",
      "radius-md": "calc(var(--radius) * 0.8)",
      "radius-xl": "calc(var(--radius) * 1.4)",
      "radius-2xl": "calc(var(--radius) * 1.8)",
      "radius-3xl": "calc(var(--radius) * 2.2)",
      "radius-shell": "calc(var(--radius) * 1.3)",
      "shadow-raised": "var(--skeuo-raised)",
      "shadow-raised-hover": "var(--skeuo-raised-hover)",
      "shadow-pressed": "var(--skeuo-pressed)",
      "shadow-primary": "var(--skeuo-primary)",
      "shadow-well": "var(--skeuo-well)",
      "shadow-surface": "var(--skeuo-surface)",
      "shadow-chip": "var(--skeuo-chip)",
      "text-ui-2xs": "0.625rem",
      "text-ui-2xs--line-height": "0.875rem",
      "text-ui-xs": "0.6875rem",
      "text-ui-xs--line-height": "0.875rem",
      "text-ui-sm": "0.75rem",
      "text-ui-sm--line-height": "1rem",
      "text-ui": "0.8125rem",
      "text-ui--line-height": "1.125rem",
      "text-ui-lg": "0.875rem",
      "text-ui-lg--line-height": "1.25rem",
      "container-reading": "68ch",
      "container-page": "76rem",
      "radius": "0.625rem"
    },
    "light": {
      "radius": "0.625rem",
      "background": "oklch(0.9911 0 0)",
      "foreground": "oklch(0.269 0 0)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.269 0 0)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.269 0 0)",
      "primary": "oklch(0.205 0 0)",
      "primary-foreground": "oklch(1 0 0)",
      "secondary": "oklch(0 0 0 / 3%)",
      "secondary-foreground": "oklch(0.269 0 0)",
      "muted": "oklch(0 0 0 / 4%)",
      "muted-foreground": "oklch(0.5155 0 0)",
      "accent": "oklch(0 0 0 / 4%)",
      "accent-foreground": "oklch(0.269 0 0)",
      "destructive": "oklch(0.58 0.2 27)",
      "success": "oklch(0.6 0.14 152)",
      "warning": "oklch(0.74 0.14 72)",
      "border": "oklch(0 0 0 / 5%)",
      "input": "oklch(0 0 0 / 6%)",
      "ring": "oklch(0.708 0 0)",
      "chart-1": "oklch(0.57 0.15 258)",
      "chart-2": "oklch(0.6 0.14 152)",
      "chart-3": "oklch(0.74 0.14 72)",
      "chart-4": "oklch(0.58 0.2 27)",
      "chart-5": "oklch(0.55 0.16 295)",
      "code": "oklch(0.9731 0 0)",
      "scrollbar": "oklch(0 0 0 / 16%)",
      "scrollbar-hover": "oklch(0 0 0 / 28%)",
      "shell": "oklch(0.9685 0 0)",
      "shell-border": "oklch(0 0 0 / 10%)",
      "skeuo-raised": "0 0 0 1px oklch(0 0 0 / 8%), 0 1px 2px oklch(0 0 0 / 5%)",
      "skeuo-raised-hover": "0 0 0 1px oklch(0 0 0 / 12%), 0 1px 2px oklch(0 0 0 / 6%)",
      "skeuo-pressed": "0 0 0 1px oklch(0 0 0 / 8%)",
      "skeuo-primary": "0 1px 2px oklch(0 0 0 / 8%)",
      "skeuo-well": "inset 0 0 0 1px oklch(0 0 0 / 8%)",
      "skeuo-surface": "0 0 0 1px oklch(0 0 0 / 6%), 0 2px 6px -2px oklch(0 0 0 / 6%), 0 12px 28px -8px oklch(0 0 0 / 14%)",
      "skeuo-chip": "0 0 0 1px oklch(0 0 0 / 6%), 0 1px 2px oklch(0 0 0 / 5%)",
      "image-outline": "oklch(0 0 0 / 0.1)"
    },
    "dark": {
      "background": "oklch(0.1638 0 0)",
      "foreground": "oklch(0.97 0 0)",
      "card": "oklch(0.1749 0 0)",
      "card-foreground": "oklch(0.97 0 0)",
      "popover": "oklch(0.1749 0 0)",
      "popover-foreground": "oklch(0.97 0 0)",
      "primary": "oklch(0.97 0 0)",
      "primary-foreground": "oklch(0.205 0 0)",
      "secondary": "oklch(1 0 0 / 4%)",
      "secondary-foreground": "oklch(0.97 0 0)",
      "muted": "oklch(1 0 0 / 4%)",
      "muted-foreground": "oklch(0.6032 0 0)",
      "accent": "oklch(1 0 0 / 4%)",
      "accent-foreground": "oklch(0.97 0 0)",
      "destructive": "oklch(0.64 0.19 25)",
      "success": "oklch(0.7 0.15 152)",
      "warning": "oklch(0.8 0.14 75)",
      "border": "oklch(1 0 0 / 4%)",
      "input": "oklch(1 0 0 / 5%)",
      "ring": "oklch(0.556 0 0)",
      "chart-1": "oklch(0.6 0.145 256)",
      "chart-2": "oklch(0.7 0.15 152)",
      "chart-3": "oklch(0.8 0.14 75)",
      "chart-4": "oklch(0.64 0.19 25)",
      "chart-5": "oklch(0.65 0.15 295)",
      "code": "oklch(0.1496 0 0)",
      "scrollbar": "oklch(1 0 0 / 14%)",
      "scrollbar-hover": "oklch(1 0 0 / 24%)",
      "shell": "oklch(0.218 0 0)",
      "shell-border": "oklch(1 0 0 / 9%)",
      "skeuo-raised": "0 0 0 1px oklch(1 0 0 / 7%)",
      "skeuo-raised-hover": "0 0 0 1px oklch(1 0 0 / 12%)",
      "skeuo-pressed": "0 0 0 1px oklch(1 0 0 / 6%)",
      "skeuo-primary": "0 0 0 0 transparent",
      "skeuo-well": "inset 0 0 0 1px oklch(1 0 0 / 7%)",
      "skeuo-surface": "0 0 0 1px oklch(1 0 0 / 7%), 0 16px 40px -12px oklch(0 0 0 / 60%)",
      "skeuo-chip": "0 0 0 1px oklch(1 0 0 / 6%)",
      "image-outline": "oklch(1 0 0 / 0.1)"
    }
  },
  "css": {
    "@layer base": {
      "::-webkit-scrollbar": {
        "width": "12px",
        "height": "12px"
      },
      "::-webkit-scrollbar-track, ::-webkit-scrollbar-corner": {
        "background": "transparent"
      },
      "::-webkit-scrollbar-thumb": {
        "border": "3px solid transparent",
        "border-radius": "9999px",
        "background-color": "var(--scrollbar)",
        "background-clip": "padding-box",
        "min-height": "40px"
      },
      "::-webkit-scrollbar-thumb:hover": {
        "background-color": "var(--scrollbar-hover)"
      },
      "@supports not selector(::-webkit-scrollbar)": {
        "*": {
          "scrollbar-width": "thin",
          "scrollbar-color": "var(--scrollbar) transparent"
        }
      },
      "body": {
        "letter-spacing": "normal"
      }
    },
    "@utility scrollbar-thin": {
      "scrollbar-width": "thin",
      "&::-webkit-scrollbar": {
        "width": "10px",
        "height": "10px"
      }
    },
    "@utility scrollbar-hover": {
      "scrollbar-color": "transparent transparent",
      "&::-webkit-scrollbar-thumb": {
        "background-color": "transparent"
      },
      "&:hover": {
        "scrollbar-color": "var(--scrollbar) transparent"
      },
      "&:hover::-webkit-scrollbar-thumb": {
        "background-color": "var(--scrollbar)"
      }
    },
    "@utility scrollbar-none": {
      "scrollbar-width": "none",
      "&::-webkit-scrollbar": {
        "display": "none"
      }
    },
    "@utility prose-qy": {
      "--prose-gap": "1.25em",
      "color": "var(--foreground)",
      "font-size": "1rem",
      "line-height": "1.75",
      "max-width": "var(--container-reading)",
      "overflow-wrap": "break-word",
      "& :where(p, ul, ol, blockquote, pre, table, figure, img, hr):not(:where(.not-prose, .not-prose *))": {
        "margin-block": "var(--prose-gap)"
      },
      "& > :where(.not-prose)": {
        "margin-block": "1.75em"
      },
      "& > :first-child": {
        "margin-top": "0"
      },
      "& > :last-child": {
        "margin-bottom": "0"
      },
      "& :where(p, li):not(:where(.not-prose, .not-prose *))": {
        "color": "color-mix(in oklch, var(--foreground) 86%, var(--muted-foreground))",
        "text-wrap": "pretty"
      },
      "& :where(h1, h2, h3, h4):not(:where(.not-prose, .not-prose *))": {
        "color": "var(--foreground)",
        "font-weight": "600",
        "letter-spacing": "-0.02em",
        "scroll-margin-top": "5rem",
        "text-wrap": "balance"
      },
      "& :where(h1):not(:where(.not-prose, .not-prose *))": {
        "font-size": "2.25rem",
        "line-height": "1.2",
        "margin-block": "0 0.8em"
      },
      "& :where(h2):not(:where(.not-prose, .not-prose *))": {
        "font-size": "1.5rem",
        "line-height": "1.3",
        "margin-block": "2.2em 0.7em"
      },
      "& :where(h3):not(:where(.not-prose, .not-prose *))": {
        "font-size": "1.25rem",
        "line-height": "1.3",
        "letter-spacing": "-0.01em",
        "margin-block": "1.8em 0.5em"
      },
      "& :where(h4):not(:where(.not-prose, .not-prose *))": {
        "font-size": "1rem",
        "line-height": "1.5",
        "letter-spacing": "0",
        "margin-block": "1.6em 0.4em"
      },
      "& :where(h2 + *, h3 + *, h4 + *):not(:where(.not-prose, .not-prose *))": {
        "margin-top": "0"
      },
      "& :where(strong):not(:where(.not-prose, .not-prose *))": {
        "color": "var(--foreground)",
        "font-weight": "600"
      },
      "& :where(a):not(:where(.not-prose, .not-prose *))": {
        "color": "var(--primary)",
        "font-weight": "500",
        "text-decoration": "underline",
        "text-decoration-color": "color-mix(in oklch, var(--primary) 40%, transparent)",
        "text-decoration-thickness": "1px",
        "text-underline-offset": "0.22em",
        "transition-property": "text-decoration-color",
        "transition-duration": "150ms",
        "transition-timing-function": "ease-out"
      },
      "& :where(a):not(:where(.not-prose, .not-prose *)):hover": {
        "text-decoration-color": "var(--primary)"
      },
      "& :where(ul, ol):not(:where(.not-prose, .not-prose *))": {
        "padding-inline-start": "1.5em"
      },
      "& :where(ul):not(:where(.not-prose, .not-prose *))": {
        "list-style": "disc"
      },
      "& :where(ol):not(:where(.not-prose, .not-prose *))": {
        "list-style": "decimal"
      },
      "& :where(li):not(:where(.not-prose, .not-prose *))": {
        "margin-block": "0.4em",
        "padding-inline-start": "0.25em"
      },
      "& :where(li)::marker": {
        "color": "var(--muted-foreground)"
      },
      "& :where(blockquote):not(:where(.not-prose, .not-prose *))": {
        "border-radius": "calc(var(--radius) + 4px)",
        "background": "color-mix(in oklch, var(--muted) 60%, transparent)",
        "box-shadow": "inset 3px 0 0 0 color-mix(in oklch, var(--primary) 70%, transparent), var(--skeuo-well)",
        "color": "var(--foreground)",
        "font-style": "italic",
        "padding": "1em 1.25em 1em 1.5em"
      },
      "& :where(blockquote p):not(:where(.not-prose, .not-prose *))": {
        "color": "inherit",
        "margin-block": "0.4em"
      },
      "& :where(code):not(:where(pre code, .not-prose, .not-prose *))": {
        "border-radius": "0.4em",
        "background": "var(--code)",
        "box-shadow": "var(--skeuo-chip)",
        "color": "var(--foreground)",
        "font-family": "var(--font-mono)",
        "font-size": "0.86em",
        "padding": "0.15em 0.4em"
      },
      "& :where(a code):not(:where(.not-prose, .not-prose *))": {
        "color": "inherit"
      },
      "& :where(pre):not(:where(.not-prose, .not-prose *))": {
        "border-radius": "calc(var(--radius) + 8px)",
        "background": "var(--code)",
        "box-shadow": "var(--skeuo-well)",
        "font-family": "var(--font-mono)",
        "font-size": "0.875em",
        "line-height": "1.6",
        "overflow-x": "auto",
        "padding": "1em 1.25em"
      },
      "& :where(hr):not(:where(.not-prose, .not-prose *))": {
        "border": "0",
        "height": "1px",
        "background": "var(--border)",
        "margin-block": "2.5em"
      },
      "& :where(img, video, svg.prose-media):not(:where(.not-prose, .not-prose *))": {
        "border-radius": "calc(var(--radius) + 8px)",
        "outline": "1px solid var(--image-outline)",
        "outline-offset": "-1px",
        "height": "auto",
        "max-width": "100%"
      },
      "& :where(figcaption):not(:where(.not-prose, .not-prose *))": {
        "color": "var(--muted-foreground)",
        "font-size": "0.875em",
        "line-height": "1.5",
        "margin-top": "0.75em",
        "text-align": "center",
        "text-wrap": "balance"
      },
      "& :where(table):not(:where(.not-prose, .not-prose *))": {
        "border-collapse": "separate",
        "border-radius": "calc(var(--radius) + 4px)",
        "border-spacing": "0",
        "box-shadow": "0 0 0 1px var(--border)",
        "font-size": "0.9em",
        "font-variant-numeric": "tabular-nums",
        "line-height": "1.5",
        "overflow": "hidden",
        "width": "100%"
      },
      "& :where(th):not(:where(.not-prose, .not-prose *))": {
        "background": "var(--muted)",
        "color": "var(--foreground)",
        "font-weight": "600",
        "text-align": "start"
      },
      "& :where(th, td):not(:where(.not-prose, .not-prose *))": {
        "border-bottom": "1px solid var(--border)",
        "padding": "0.6em 0.9em"
      },
      "& :where(tr:last-child td):not(:where(.not-prose, .not-prose *))": {
        "border-bottom": "0"
      },
      "& :where(kbd):not(:where(.not-prose, .not-prose *))": {
        "border-radius": "0.375em",
        "background": "var(--muted)",
        "box-shadow": "var(--skeuo-chip)",
        "font-family": "var(--font-mono)",
        "font-size": "0.8em",
        "padding": "0.1em 0.4em"
      }
    },
    "@utility shell-inset": {
      "background-color": "var(--background)",
      "border": "0.5px solid var(--shell-border)",
      "border-radius": "calc(var(--radius) * 1.3)",
      "margin-inline-end": "3px",
      "margin-bottom": "3px"
    }
  },
  "meta": {
    "category": "Foundations"
  },
  "type": "registry:theme"
}