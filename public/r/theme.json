      "scrollbar-hover": "oklch(100% 0 0 / 24%)",
      "shell": "oklch(20.5% 0 0)",
      "shell-border": "oklch(100% 0 0 / 9%)",
      "skeuo-raised": "0 0 0 1px oklch(100% 0 0 / 12%), 0 1px 1px oklch(0% 0 0 / 14%)",
      "skeuo-raised-hover": "0 0 0 1px oklch(100% 0 0 / 20%), 0 1px 1px oklch(0% 0 0 / 14%)",
      "skeuo-pressed": "0 0 0 1px oklch(100% 0 0 / 8%)",
      "skeuo-primary": "0 0 0 0 transparent",
      "skeuo-well": "inset 0 0 0 1px oklch(100% 0 0 / 12%)",
      "skeuo-surface": "0 0 0 1px oklch(100% 0 0 / 12%), 0 1px 2px oklch(0% 0 0 / 18%), 0 4px 12px -4px oklch(0% 0 0 / 36%)",
      "skeuo-chip": "0 0 0 1px oklch(100% 0 0 / 10%)",
      "image-outline": "oklch(1 0 0 / 0.1)"
    }
  },
  "css": {
    "@layer base": {
      "::-webkit-scrollbar": {
        "width": "12px",
        "height": "12px"
      },
      "::-webkit-scrollbar-track, ::-webkit-scrollbar-corner": {
        "background": "transparent"
      },
      "::-webkit-scrollbar-thumb": {
        "border": "3px solid transparent",
        "border-radius": "9999px",
        "background-color": "var(--scrollbar)",
        "background-clip": "padding-box",
        "min-height": "40px"
      },
      "::-webkit-scrollbar-thumb:hover": {
        "background-color": "var(--scrollbar-hover)"
      },
      "@supports not selector(::-webkit-scrollbar)": {
        "*": {
          "scrollbar-width": "thin",
          "scrollbar-color": "var(--scrollbar) transparent"
        }
      },
      "body": {
        "letter-spacing": "normal"
      }
    },
    "@utility scrollbar-thin": {
      "scrollbar-width": "thin",
      "&::-webkit-scrollbar": {
        "width": "10px",
        "height": "10px"
      }
    },
    "@utility scrollbar-hover": {
      "scrollbar-color": "transparent transparent",
      "&::-webkit-scrollbar-thumb": {
        "background-color": "transparent"
      },
      "&:hover": {
        "scrollbar-color": "var(--scrollbar) transparent"
      },
      "&:hover::-webkit-scrollbar-thumb": {
        "background-color": "var(--scrollbar)"
      }
    },
    "@utility scrollbar-none": {
      "scrollbar-width": "none",
      "&::-webkit-scrollbar": {
        "display": "none"
      }
    },
    "@utility shell-inset": {
      "background-color": "var(--background)",
      "border": "0.5px solid var(--shell-border)",
      "border-radius": "calc(var(--radius) * 1.3)",
      "margin-inline-end": "3px",
      "margin-bottom": "3px"
    },
    "@utility window-drag": {
      "-webkit-app-region": "drag",
      "user-select": "none"
    },
    "@utility window-no-drag": {
      "-webkit-app-region": "no-drag"
    }
  },
  "meta": {
    "category": "Foundations"
  },
  "type": "registry:theme"
}