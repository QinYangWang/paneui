{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-violet",
  "title": "Theme: Violet accent",
  "description": "Violet accent preset: swaps the neutral primary, primary-foreground and ring for violet in light and dark. Install after @qinyang/theme.",
  "registryDependencies": [
    "@qinyang/theme"
  ],
  "cssVars": {
    "light": {
      "primary": "oklch(0.55 0.18 290)",
      "primary-foreground": "oklch(1 0 0)",
      "ring": "oklch(0.55 0.18 290 / 45%)"
    },
    "dark": {
      "primary": "oklch(0.64 0.16 290)",
      "primary-foreground": "oklch(1 0 0)",
      "ring": "oklch(0.64 0.16 290 / 50%)"
    }
  },
  "meta": {
    "category": "Foundations",
    "hidden": true
  },
  "type": "registry:theme"
}