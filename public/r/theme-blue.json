{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-blue",
  "title": "Theme: Blue accent",
  "description": "Blue accent preset: swaps the neutral primary, primary-foreground and ring for blue in light and dark. Install after @qinyang/theme.",
  "registryDependencies": [
    "@qinyang/theme"
  ],
  "cssVars": {
    "light": {
      "primary": "oklch(0.57 0.15 258)",
      "primary-foreground": "oklch(1 0 0)",
      "ring": "oklch(0.57 0.15 258)"
    },
    "dark": {
      "primary": "oklch(0.6 0.145 256)",
      "primary-foreground": "oklch(1 0 0)",
      "ring": "oklch(0.6 0.145 256)"
    }
  },
  "meta": {
    "category": "Foundations",
    "hidden": true
  },
  "type": "registry:theme"
}