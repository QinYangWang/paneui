{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-neutral",
  "title": "Theme: Neutral accent",
  "description": "Accent preset that makes the primary colour black or white.",
  "registryDependencies": [
    "https://qinyangwang.github.io/ui/r/theme.json"
  ],
  "cssVars": {
    "light": {
      "primary": "#000000f2",
      "primary-hover": "#000c",
      "primary-active": "#000000b3",
      "primary-foreground": "#fff",
      "primary-subtle": "#0000000f",
      "primary-subtle-hover": "#00000017",
      "primary-border": "#00000026",
      "ring": "#0004"
    },
    "dark": {
      "primary": "#fffffff2",
      "primary-hover": "#fffc",
      "primary-active": "#ffffffb3",
      "primary-foreground": "#000",
      "primary-subtle": "#ffffff12",
      "primary-subtle-hover": "#ffffff1b",
      "primary-border": "#ffffff2c",
      "ring": "#fff5"
    }
  },
  "meta": {
    "category": "Foundations",
    "hidden": true
  },
  "type": "registry:theme"
}